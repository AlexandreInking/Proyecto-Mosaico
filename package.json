{
  "name": "mosaico-platform",
  "private": true,
  "version": "0.2.17",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@tauri-apps/cli-win32-x64-msvc": "2.11.4"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "installer:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-custom-installer.ps1",
    "build:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-demo.ps1",
    "dev:web": "pnpm --filter @mosaico/web-client dev",
    "dev:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-desktop-dev.ps1",
    "dev:api": "pnpm --filter @mosaico/web-server dev",
    "test": "node --test tests/t0/*.test.mjs tests/t1/*.test.mjs tests/t2/*.test.mjs && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "benchmark:t1": "node scripts/t1-benchmark.mjs",
    "gate:t1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/t1-gate.ps1"
  }
}
