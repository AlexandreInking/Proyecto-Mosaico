{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mosaico",
  "version": "0.2.0",
  "identifier": "com.proyectomosaico.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../app dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../app build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mosaico — Asset Pipeline AI",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
