<Window x:Class="Mosaico.App.CellSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mosaico.App"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Tamaño de celda" Width="420" Height="285" ResizeMode="NoResize"
        Style="{StaticResource DarkWindowStyle}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Tamaño de celda base" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="Cambia la cuadrícula; tiles y coordenadas permanecen intactos."
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Ancho (px)" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="CellWidthBox" automation:AutomationProperties.Name="Ancho de celda en píxeles" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Alto (px)" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="CellHeightBox" automation:AutomationProperties.Name="Alto de celda en píxeles" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        <DockPanel Grid.Row="3">
            <TextBlock Text="8…2048 px por eje" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Style="{StaticResource IconButton}" Click="Cancel_Click" ToolTip="Cancelar" automation:AutomationProperties.Name="Cancelar">
                    <local:LucideIcon IconName="x" Width="18" Height="18" Foreground="{StaticResource TextBrush}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Click="Confirm_Click" ToolTip="Aplicar" automation:AutomationProperties.Name="Aplicar tamaño de celda">
                    <local:LucideIcon IconName="check" Width="18" Height="18" Foreground="{StaticResource TextBrush}" />
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
