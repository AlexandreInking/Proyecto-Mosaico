<Window x:Class="Mosaico.App.TilesetImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mosaico.App"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Importar sprite sheet" Width="980" Height="680" MinWidth="820" MinHeight="580"
        Style="{StaticResource DarkWindowStyle}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Importar sprite sheet" FontSize="19" FontWeight="SemiBold" />
            <TextBlock x:Name="SourceText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,14" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Nombre de pestaña" Foreground="{StaticResource MutedBrush}" />
                    <TextBox x:Name="NameBox" MaxLength="128" TextChanged="Input_Changed"
                             automation:AutomationProperties.Name="Nombre del tileset y pestaña" />
                    <TextBlock Text="Tamaño de cada tile" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Ancho (px)" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="TileWidthBox" Text="16" TextChanged="Input_Changed" automation:AutomationProperties.Name="Ancho del tile"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Alto (px)" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="TileHeightBox" Text="16" TextChanged="Input_Changed" automation:AutomationProperties.Name="Alto del tile"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Margen exterior" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Horizontal" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="MarginXBox" Text="0" TextChanged="Input_Changed" automation:AutomationProperties.Name="Margen horizontal"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Vertical" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="MarginYBox" Text="0" TextChanged="Input_Changed" automation:AutomationProperties.Name="Margen vertical"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Distancia entre tiles" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Horizontal" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="SpacingXBox" Text="0" TextChanged="Input_Changed" automation:AutomationProperties.Name="Espaciado horizontal"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Vertical" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="SpacingYBox" Text="0" TextChanged="Input_Changed" automation:AutomationProperties.Name="Espaciado vertical"/></StackPanel>
                    </Grid>
                    <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="11" Margin="0,7,0,0">
                        <StackPanel>
                            <TextBlock Text="Resultado" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CountText" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"/>
                            <TextBlock Text="IDs row-major desde 0. El color rojo indica margen; amarillo, distancia entre tiles."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                <TextBlock Text="Sprite sheet completo" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border Grid.Row="1" Background="#151515" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock Grid.Row="3" Text="Detalle 2 × 2 para comparar corte, margen y distancia" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border Grid.Row="4" Background="#151515" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <local:TilesetSlicePreview x:Name="SlicePreview"
                                               automation:AutomationProperties.Name="Comparación visual de cuatro tiles" />
                </Border>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Style="{StaticResource IconButton}" Click="Cancel_Click" ToolTip="Cancelar" automation:AutomationProperties.Name="Cancelar">
                    <local:LucideIcon IconName="x" Width="18" Height="18" Foreground="{StaticResource TextBrush}" />
                </Button>
                <Button x:Name="ConfirmButton" Style="{StaticResource IconButton}" Click="Confirm_Click" ToolTip="Importar tileset" automation:AutomationProperties.Name="Importar tileset">
                    <local:LucideIcon IconName="check" Width="18" Height="18" Foreground="{StaticResource TextBrush}" />
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
