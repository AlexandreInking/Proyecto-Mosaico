<Window x:Class="Mosaico.App.NewMapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mosaico.App"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Nuevo mapa ortogonal" Width="440" Height="410" MinWidth="440" MinHeight="410"
        Style="{StaticResource DarkWindowStyle}" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Nuevo mapa ortogonal" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="Define dimensiones del mapa y de su cuadrícula base."
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Nombre" Foreground="{StaticResource MutedBrush}" />
            <TextBox x:Name="NameBox" Text="Mapa sin título" MaxLength="128"
                     automation:AutomationProperties.Name="Nombre del mapa" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Ancho del mapa (celdas)" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="WidthBox" Text="32" automation:AutomationProperties.Name="Ancho en celdas" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Alto del mapa (celdas)" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="HeightBox" Text="18" automation:AutomationProperties.Name="Alto en celdas" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Ancho de celda (px)" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="CellWidthBox" Text="16" automation:AutomationProperties.Name="Ancho de celda base en píxeles" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Alto de celda (px)" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="CellHeightBox" Text="16" automation:AutomationProperties.Name="Alto de celda base en píxeles" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                   VerticalAlignment="Top" TextWrapping="Wrap" Margin="0,2,0,8" />
        <DockPanel Grid.Row="5">
            <TextBlock Text="Celda permitida: 8…2048 px por eje" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Style="{StaticResource IconButton}" Click="Cancel_Click" ToolTip="Cancelar" automation:AutomationProperties.Name="Cancelar">
                    <local:LucideIcon IconName="x" Width="18" Height="18" Foreground="{StaticResource TextBrush}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Click="Confirm_Click" ToolTip="Crear mapa" automation:AutomationProperties.Name="Crear mapa">
                    <local:LucideIcon IconName="check" Width="18" Height="18" Foreground="{StaticResource TextBrush}" />
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
